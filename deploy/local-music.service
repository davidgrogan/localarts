[Unit]
Description=Local Music POC (gunicorn)
After=network.target

[Service]
# Matches this droplet's existing convention (see yt-playlist-podcaster):
# apps live under /var/www/<name> and run as root. Adjust if that changes.
WorkingDirectory=/var/www/localarts
EnvironmentFile=/var/www/localarts/deploy/local-music.env
ExecStart=/var/www/localarts/.venv/bin/gunicorn \
    --workers 3 \
    --bind 127.0.0.1:8000 \
    --access-logfile - \
    --error-logfile - \
    wsgi:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
