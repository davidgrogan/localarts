# Copy to /etc/nginx/sites-available/local-music, symlink into
# sites-enabled, then run `certbot --nginx` to fill in the HTTPS block
# automatically (see DEPLOY.md) -- don't hand-write the SSL directives.
server {
    listen 80;
    server_name YOUR_DOMAIN_HERE;

    location /static/ {
        alias /home/localmusic/local-music-poc/app/static/;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
