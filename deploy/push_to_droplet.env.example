# Copy this file to deploy/push_to_droplet.env (gitignored, never committed)
# and fill in real values. Used by push_to_droplet.sh / "Push to Droplet.command"
# to send your local scan/review/tagging data up to the droplet with one command.

# SSH user + IP of the droplet (same ones you use to `ssh` in by hand).
DROPLET_SSH_USER=root
DROPLET_IP=YOUR_DROPLET_IP

# The localarts Postgres user's password on the droplet (see DEPLOY.md
# step 2 -- this is NOT your SSH password).
DROPLET_PG_PASSWORD=YOUR_PG_PASSWORD

# Local port to tunnel through. Only change this if 5433 is already in
# use by something else on your Mac.
LOCAL_TUNNEL_PORT=5433
