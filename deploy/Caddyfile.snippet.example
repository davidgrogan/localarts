# Paste this INSIDE your existing `waveyvibe.dev { ... }` block in
# /etc/caddy/Caddyfile, above the existing `root * /var/www/waveyvibe` /
# `file_server` lines (Caddy tries handle_path blocks in the order they
# appear, so this needs to come first or file_server would answer
# /localarts/* itself with a 404 before ever reaching this block).
#
# handle_path strips the matched "/localarts" prefix before forwarding to
# gunicorn, so the app itself doesn't need to know about the prefix for
# routing -- but it DOES need to know for generating correct links back to
# itself (url_for(), static file URLs, form actions), which is what the
# X-Forwarded-Prefix header is for. wsgi.py already reads it via
# Werkzeug's ProxyFix, so no app-side config beyond that is needed.
#
# End result: waveyvibe.dev { ... } should look like --
#
#   waveyvibe.dev {
#       handle_path /localarts/* {
#           reverse_proxy localhost:8000 {
#               header_up X-Forwarded-Prefix "/localarts"
#           }
#       }
#       root * /var/www/waveyvibe
#       file_server
#   }

handle_path /localarts/* {
    reverse_proxy localhost:8000 {
        header_up X-Forwarded-Prefix "/localarts"
    }
}
