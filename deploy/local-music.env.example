# Copy to deploy/local-music.env on the droplet (NOT committed to git --
# it holds real secrets) and fill in real values. Referenced by both
# systemd units via EnvironmentFile=.
DATABASE_URL=postgresql://localmusic:REPLACE_ME@127.0.0.1:5432/localmusic
SECRET_KEY=REPLACE_ME

# SESSION_COOKIE_NAME: gives this app's session cookie a name distinct
# from a plain "session" so it can't be confused with a sibling app's own
# cookie on the same domain (e.g. waveyvibe.dev's other apps). Safe to set
# regardless of how this app is reached.
#
# SESSION_COOKIE_PATH: only set this to /localarts if the ONLY way this
# app is ever reached is the path-mounted URL (waveyvibe.dev/localarts) --
# it narrows the cookie so the browser only sends it back on requests
# under that path. The moment this app is ALSO reachable at its own
# custom domain's root (see DEPLOY.md's "Pointing a custom domain" section)
# while still keeping the old path-mounted URL working too, this needs to
# be unset (or set to "/", which app/__init__.py already falls back to
# when this var is absent) -- a cookie scoped to /localarts is simply
# never sent back for a request to the custom domain's root "/", which
# means admin login would silently appear broken there even though
# everything else on the site works fine (browsing needs no cookie at
# all). A cookie scoped to "/" still covers every /localarts/* request
# too, so this is a safe default either way -- narrow it back down only
# if this ever goes back to being reachable at just one path-mounted URL.
SESSION_COOKIE_NAME=localarts_session

# Gates all admin routes (venue/event management, review queue, artist
# add/edit/delete) behind a login. Generate the hash with:
#   python3 -c "from werkzeug.security import generate_password_hash as g; print(g('your-real-password'))"
# Do NOT leave this unset on a real deployment -- it'd fall back to the
# admin/admin dev default, which is fine on your laptop and nowhere else.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=REPLACE_ME

# Admin email notifications (contact form + "Submit your show") -- sent
# via Resend's HTTPS API, not direct SMTP. Direct Gmail SMTP had to be
# abandoned after outbound SMTP turned out to be silently blocked from
# this droplet -- see README.md's "Hardened against a hung mail server"
# section. Get a key at https://resend.com/api-keys. See .env.example
# for the full explanation.
RESEND_API_KEY=REPLACE_ME
# Optional -- only needed once a custom domain is verified with Resend.
RESEND_FROM_EMAIL=
CONTACT_EMAIL=davidbgrogan@gmail.com
