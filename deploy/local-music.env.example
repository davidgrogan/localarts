# Copy to deploy/local-music.env on the droplet (NOT committed to git --
# it holds real secrets) and fill in real values. Referenced by both
# systemd units via EnvironmentFile=.
DATABASE_URL=postgresql://localmusic:REPLACE_ME@127.0.0.1:5432/localmusic
SECRET_KEY=REPLACE_ME

# Only needed when this app is mounted under a path on a shared domain
# (e.g. waveyvibe.dev/localarts) instead of owning a whole domain --
# scopes the session cookie so it can't collide with other apps' cookies
# on the same domain. Leave unset (or delete these two lines) for a
# single-app-per-domain deployment.
SESSION_COOKIE_PATH=/localarts
SESSION_COOKIE_NAME=localarts_session
