# Copy to .env for local testing against a real Postgres, or set these as
# real environment variables on the droplet (see deploy/local-music.env
# and DEPLOY.md). Neither is required for plain local dev -- with nothing
# set, the app falls back to the SQLite file in instance/.

# A real Postgres connection string, e.g.
# postgresql://localmusic:password@127.0.0.1:5432/localmusic
DATABASE_URL=

# Any long random string -- used to sign Flask's session cookie.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
