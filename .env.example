# Copy to .env for local testing against a real Postgres, or set these as
# real environment variables on the droplet (see deploy/local-music.env
# and DEPLOY.md). Neither is required for plain local dev -- with nothing
# set, the app falls back to the SQLite file in instance/.

# A real Postgres connection string, e.g.
# postgresql://localmusic:password@127.0.0.1:5432/localmusic
DATABASE_URL=

# Any long random string -- used to sign Flask's session cookie.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Gates every venue/event management route, the review queue, and adding/
# editing/deleting artists behind a login. If left unset, defaults to
# admin/admin -- fine for poking around locally, NOT fine for anything
# that's actually reachable on the internet.
ADMIN_USERNAME=admin
# A password *hash*, not the raw password. Generate one with:
#   python3 -c "from werkzeug.security import generate_password_hash as g; print(g('your-real-password'))"
ADMIN_PASSWORD_HASH=

# Admin email notifications (contact form + "Submit your show") --
# sent via Resend (https://resend.com), a transactional email API over
# HTTPS. Direct Gmail SMTP was tried first but had to be abandoned: on
# 2026-08-17 a hung SMTP connection took down an entire gunicorn worker,
# and once that was fixed, it turned out outbound SMTP (ports 587/465)
# was silently blocked from the droplet entirely -- see README.md's
# "Hardened against a hung mail server" section for the full story.
#   1. Sign up at https://resend.com (free tier is plenty for this site's
#      volume).
#   2. Create an API key: https://resend.com/api-keys
#   3. RESEND_API_KEY is that key.
# Without RESEND_API_KEY set, the contact form and "Submit your show"
# still work (submissions are saved either way) but show an error
# instead of silently pretending to send the notification email.
RESEND_API_KEY=
# Optional -- defaults to Resend's zero-setup onboarding@resend.dev
# sender, which works immediately but only for a limited volume/reach.
# Set this once you verify your own domain with Resend, e.g.
#   Paradise City Music <notifications@yourdomain.com>
RESEND_FROM_EMAIL=
# Defaults to davidbgrogan@gmail.com if unset -- only need this if
# messages should go somewhere else.
CONTACT_EMAIL=
