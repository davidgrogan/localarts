# Copy to .env for local testing against a real Postgres, or set these as
# real environment variables on the droplet (see deploy/local-music.env
# and DEPLOY.md). Neither is required for plain local dev -- with nothing
# set, the app falls back to the SQLite file in instance/.

# A real Postgres connection string, e.g.
# postgresql://localmusic:password@127.0.0.1:5432/localmusic
DATABASE_URL=

# Any long random string -- used to sign Flask's session cookie.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Gates every venue/event management route, the review queue, and adding/
# editing/deleting artists behind a login. If left unset, defaults to
# admin/admin -- fine for poking around locally, NOT fine for anything
# that's actually reachable on the internet.
ADMIN_USERNAME=admin
# A password *hash*, not the raw password. Generate one with:
#   python3 -c "from werkzeug.security import generate_password_hash as g; print(g('your-real-password'))"
ADMIN_PASSWORD_HASH=

# Contact form (app/routes/contact.py) -- sends via Gmail SMTP using an
# account "App Password", not your real Gmail password:
#   1. Turn on 2-Step Verification on the Gmail account, if not already on:
#      https://myaccount.google.com/security
#   2. Generate an App Password: https://myaccount.google.com/apppasswords
#      (choose "Mail" / "Other", copy the 16-character code it gives you)
#   3. MAIL_USERNAME is that Gmail address; MAIL_PASSWORD is the App
#      Password from step 2 (with or without spaces, either works).
# Without these set, the contact form still renders but shows an error
# instead of silently pretending to send.
MAIL_USERNAME=
MAIL_PASSWORD=
# Defaults to davidbgrogan@gmail.com if unset -- only need this if
# messages should go somewhere else.
CONTACT_EMAIL=
